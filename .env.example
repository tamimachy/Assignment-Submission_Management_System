# Backend Environment Configuration
ASPNETCORE_ENVIRONMENT=Development
DbProvider=PostgreSQL # Options: PostgreSQL, SQLite
ConnectionStrings__DefaultConnection=Host=localhost;Database=AssignmentMgmtDb;Username=postgres;Password=postgres
ConnectionStrings__SqliteConnection=Data Source=assignment_mgmt.db
Jwt__Key=Your_Super_Secret_Key_Which_Must_Be_At_Least_32_Bytes_Long!
Jwt__Issuer=AssignmentMgmtAPI
Jwt__Audience=AssignmentMgmtUsers
