                <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs">Save Course</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: ADD / EDIT SUBJECT & ASSIGN TEACHER -->
<div id="subjectModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg shadow-2xl p-6 space-y-4 text-slate-100">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="text-lg font-bold text-white" id="subjectModalTitle">Add Subject & Assign Teacher</h3>
            <button onclick="closeModal('subjectModal')" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form onsubmit="saveSubject(event)" class="space-y-4">
            <input type="hidden" id="subjIdInput" />
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Subject Name *</label>
                <input type="text" id="subjNameInput" placeholder="e.g. Object Oriented Programming" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm text-white" required />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Subject Code *</label>
                <input type="text" id="subjCodeInput" placeholder="e.g. CSE-201" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm text-white" required />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Course *</label>
                <select id="subjCourseInput" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm text-white" required></select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Assign Teacher</label>
                <select id="subjTeacherInput" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-sm text-white">
                    <option value="">(Unassigned)</option>
                </select>
            </div>
            <div class="flex justify-end gap-3 pt-3 border-t border-slate-800">
                <button type="button" onclick="closeModal('subjectModal')" class="px-4 py-2 text-xs font-semibold text-slate-400">Cancel</button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs">Save Subject</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    var token = localStorage.getItem('jwt_token');
    var currentUser = null;
    try {
        var rawUser = localStorage.getItem('user_data');
        if (rawUser && rawUser !== 'undefined') {
            currentUser = JSON.parse(rawUser);
        }
    } catch (e) {
        currentUser = null;
    }
    var subjectsCache = [];
    var assignmentsCache = [];

    function setDemoLogin(email, password) {
        document.getElementById('loginEmail').value = email;
        document.getElementById('loginPassword').value = password;
    }

    async function handleLogin(e) {
        if (e && e.preventDefault) e.preventDefault();
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        const alertBox = document.getElementById('authAlert');
        const submitBtn = document.getElementById('authSubmitBtn');
        
        if (!email || !password) return;
        
        if (submitBtn) submitBtn.disabled = true;
        alertBox.classList.add('hidden');

        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });

            if (!res.ok) {
                let errText = 'Login failed';
                try {
                    const errObj = await res.json();
                    errText = errObj.message || errText;
                } catch {
                    errText = await res.text();
                }
                throw new Error(errText);
            }

            const data = await res.json();
            token = data.token;
            currentUser = data.user || data;
            localStorage.setItem('jwt_token', token);
            localStorage.setItem('user_data', JSON.stringify(currentUser));

            renderPortal();
        } catch (err) {
            alertBox.innerText = err.message || 'Authentication failed';
            alertBox.classList.remove('hidden');
        } finally {
            if (submitBtn) submitBtn.disabled = false;
        }
    }

    function handleLogout() {
        token = null;
        currentUser = null;
        localStorage.removeItem('jwt_token');
        localStorage.removeItem('user_data');
        document.getElementById('authSection').classList.remove('hidden');
        document.getElementById('dashboardSection').classList.add('hidden');
    }

    function renderPortal() {
        if (!token || !currentUser) {
            const authSec = document.getElementById('authSection');
            const dashSec = document.getElementById('dashboardSection');
            if (authSec) authSec.classList.remove('hidden');
            if (dashSec) dashSec.classList.add('hidden');
            return;
        }

        const authSec = document.getElementById('authSection');
        const dashSec = document.getElementById('dashboardSection');
        if (authSec) authSec.classList.add('hidden');
        if (dashSec) dashSec.classList.remove('hidden');

        const userNameEl = document.getElementById('userName');
        if (userNameEl) userNameEl.innerText = currentUser.name || 'User';

        const userAvatarEl = document.getElementById('userAvatar');
        if (userAvatarEl && currentUser.name) {
            userAvatarEl.innerText = currentUser.name.charAt(0).toUpperCase();
        }

        const roleStr = (currentUser.role !== undefined && currentUser.role !== null) ? currentUser.role.toString() : '';
        const isAdmin = roleStr === 'Admin' || roleStr === '0';
        const isTeacher = roleStr === 'Teacher' || roleStr === '1';
        const roleDisplay = isAdmin ? 'Admin' : isTeacher ? 'Teacher' : 'Student';

        const roleBadge = document.getElementById('userRoleBadge');
        if (roleBadge) roleBadge.innerText = roleDisplay;

        const navCourses = document.getElementById('nav-courses');
        if (navCourses) {
            if (isAdmin || isTeacher) navCourses.classList.remove('hidden');
            else navCourses.classList.add('hidden');
        }

        const btnCreate = document.getElementById('btnCreateAssignment');
        if (btnCreate) {
            if (isAdmin || isTeacher) btnCreate.classList.remove('hidden');
            else btnCreate.classList.add('hidden');
        }

        const courseAdminBtns = document.getElementById('courseAdminBtns');
        if (courseAdminBtns) {
            if (isAdmin) {
                courseAdminBtns.innerHTML = `
                    <button onclick="openCourseModal()" class="px-3.5 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-md">+ Add Course</button>
                    <button onclick="openSubjectModal()" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-indigo-300 font-semibold text-xs border border-slate-700">+ Add Subject & Assign Teacher</button>
                `;
            } else {
                courseAdminBtns.innerHTML = '';
            }
        }

        const navUsers = document.getElementById('nav-users');
        if (navUsers) {
            if (isAdmin) navUsers.classList.remove('hidden');
            else navUsers.classList.add('hidden');
        }

        const adminMetricsSec = document.getElementById('adminMetricsSection');
        if (adminMetricsSec) {
            if (isAdmin) adminMetricsSec.classList.remove('hidden');
            else adminMetricsSec.classList.add('hidden');
        }

        const teacherSec = document.getElementById('teacherCoursesSection');
        if (teacherSec) {
            if (isTeacher) teacherSec.classList.remove('hidden');
            else teacherSec.classList.add('hidden');
        }

        loadDashboardData();
    }

    function switchTab(tabId) {
        document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
        document.getElementById('tab-' + tabId).classList.remove('hidden');

        document.querySelectorAll('#sidebarNav button').forEach(btn => {
            btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
            btn.classList.add('text-slate-400');
        });

        const activeBtn = document.getElementById('nav-' + tabId);
        if (activeBtn) {
            activeBtn.classList.remove('text-slate-400');
            activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
        }

        if (tabId === 'assignments') loadAssignments();
        if (tabId === 'submissions') loadSubmissions();
        if (tabId === 'courses') loadCourses();
        if (tabId === 'users') loadUsers();
    }

    async function apiFetch(url, options = {}) {
        options.headers = {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token,
            ...(options.headers || {})
        };
        const res = await fetch(url, options);
        if (res.status === 401) {
            handleLogout();
            throw new Error('Unauthorized');
        }
        return res;
    }

    async function loadDashboardData() {
        try {
            const roleStr = (currentUser && currentUser.role !== undefined && currentUser.role !== null) ? currentUser.role.toString() : '';
            const isAdmin = roleStr === 'Admin' || roleStr === '0';
            const isTeacher = roleStr === 'Teacher' || roleStr === '1';

            const adminMetricsSec = document.getElementById('adminMetricsSection');
            if (adminMetricsSec) {
                if (isAdmin) adminMetricsSec.classList.remove('hidden');
                else adminMetricsSec.classList.add('hidden');
            }

            const teacherSec = document.getElementById('teacherCoursesSection');
            if (teacherSec) {
                if (isTeacher) teacherSec.classList.remove('hidden');
                else teacherSec.classList.add('hidden');
            }

            if (isAdmin) {
                const statsRes = await apiFetch('/api/dashboard/stats');
                if (statsRes.ok) {
                    const s = await statsRes.json();
                    document.getElementById('statsGrid').innerHTML = `
                        <div class="p-5 rounded-2xl bg-slate-900 border border-indigo-500/20 shadow-xl">
                            <span class="text-xs font-semibold text-indigo-400 uppercase">Assignments</span>
                            <p class="text-3xl font-extrabold text-white mt-2">${s.totalAssignments}</p>
                        </div>
                        <div class="p-5 rounded-2xl bg-slate-900 border border-amber-500/20 shadow-xl">
                            <span class="text-xs font-semibold text-amber-400 uppercase">Submissions</span>
                            <p class="text-3xl font-extrabold text-white mt-2">${s.totalSubmissions}</p>
                        </div>
                        <div class="p-5 rounded-2xl bg-slate-900 border border-emerald-500/20 shadow-xl">
                            <span class="text-xs font-semibold text-emerald-400 uppercase">Average Score</span>
                            <p class="text-3xl font-extrabold text-white mt-2">${s.averageClassScore}</p>
                        </div>
                        <div class="p-5 rounded-2xl bg-slate-900 border border-violet-500/20 shadow-xl">
                            <span class="text-xs font-semibold text-violet-400 uppercase">Users / Courses</span>
                            <p class="text-3xl font-extrabold text-white mt-2">${s.totalUsers} / ${s.totalCourses}</p>
                        </div>
                    `;
                }
            }

            if (isTeacher) {
                try {
                    const subjRes = await apiFetch('/api/courses/subjects?teacherId=' + currentUser.id);
                    let mySubjects = [];
                    if (subjRes.ok) {
                        mySubjects = await subjRes.json();
                    }
                    const grid = document.getElementById('teacherCoursesGrid');
                    if (grid) {
                        if (mySubjects && mySubjects.length > 0) {
                            grid.innerHTML = mySubjects.map(s => `
                                <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60 space-y-2">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">${s.code || 'Subject'}</span>
                                        <span class="text-xs font-semibold text-indigo-400">${s.courseName || ''}</span>
                                    </div>
                                    <h4 class="text-sm font-bold text-white">${s.name}</h4>
                                    <p class="text-xs text-slate-400 flex items-center gap-1.5 pt-1">
                                        <i class="fa-solid fa-graduation-cap text-amber-400 text-xs"></i>
                                        <span>Course: <strong class="text-slate-200">${s.courseName || 'General'}</strong></span>
                                    </p>
                                </div>
                            `).join('');
                        } else if (currentUser.courseName) {
                            grid.innerHTML = `
                                <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/60 space-y-2 col-span-full">
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Assigned Department</span>
                                    <h4 class="text-sm font-bold text-white">${currentUser.courseName}</h4>
                                    <p class="text-xs text-slate-400">Assigned Course / Department: ${currentUser.courseName}</p>
                                </div>
                            `;
                        } else {
                            grid.innerHTML = `
                                <div class="p-4 rounded-xl bg-slate-800/40 border border-slate-800 text-slate-400 text-xs col-span-full italic">
                                    No subjects or courses currently assigned to your account.
                                </div>
                            `;
                        }
                    }
                } catch (err) {
                    console.error('Error loading teacher courses:', err);
                }
            }

            const asgnRes = await apiFetch('/api/assignments');
            if (asgnRes.ok) {
                assignmentsCache = await asgnRes.json();
                document.getElementById('recentAssignmentsGrid').innerHTML = assignmentsCache.slice(0, 4).map(a => `
                    <div class="p-4 rounded-xl bg-slate-800/50 border border-slate-700/50 space-y-2">
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">${a.subjectName}</span>
                        <h4 class="text-sm font-bold text-white">${a.title}</h4>
                        <p class="text-xs text-slate-400 line-clamp-2">${a.description}</p>
                    </div>
                `).join('');
            }

            const subjRes = await apiFetch('/api/courses/subjects');
            if (subjRes.ok) {
                subjectsCache = await subjRes.json();
            }
        } catch (e) {
            console.error(e);
        }
    }

    var coursesCache = [];
    var teachersCache = [];

    async function loadAssignments() {
        const list = document.getElementById('assignmentsList');
        const roleStr = currentUser.role.toString();
        const isAdmin = roleStr === 'Admin' || roleStr === '0';
        const isTeacher = roleStr === 'Teacher' || roleStr === '1';
        const isStudent = roleStr === 'Student' || roleStr === '2';

        if (!assignmentsCache || assignmentsCache.length === 0) {
            list.innerHTML = `<div class="p-8 text-center text-slate-400 bg-slate-900/50 rounded-2xl border border-slate-800">No assignments available.</div>`;
            return;
        }

        list.innerHTML = assignmentsCache.map(a => {
            const isClosed = new Date() > new Date(a.deadline);
            const mySub = a.mySubmission;
            const statusBadge = a.isDraft 
                ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700">Draft</span>`
                : `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Published</span>`;

            return `
                <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 flex flex-col md:flex-row justify-between gap-4 shadow-lg hover:border-slate-700 transition-all">
                    <div class="space-y-2 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">${a.subjectName || 'Subject'}</span>
                            ${statusBadge}
                        </div>
                        <h3 class="text-base font-bold text-white">${a.title}</h3>
                        <p class="text-xs text-slate-300 whitespace-pre-wrap">${a.description}</p>
                        <div class="text-xs text-slate-400 pt-1 flex items-center gap-4">
                            <span><i class="fa-regular fa-clock me-1 text-slate-500"></i>Deadline: <strong class="text-slate-200">${new Date(a.deadline).toLocaleString()}</strong></span>
                            <span><i class="fa-solid fa-award me-1 text-amber-500"></i>Max Marks: <strong class="text-amber-400">${a.maximumMarks}</strong></span>
                        </div>
                    </div>
                    <div class="flex flex-col justify-center items-end gap-2 border-t md:border-t-0 md:border-l border-slate-800/80 pt-3 md:pt-0 md:pl-4">
                        ${isStudent ? `
                            ${mySub ? `
                                <div class="text-right">
                                    <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 block">${mySub.status}</span>
                                    <span class="text-[11px] text-slate-400 mt-1 block">Marks: <strong class="text-amber-400">${mySub.marksAwarded ?? '-'} / ${a.maximumMarks}</strong></span>
                                </div>
                            ` : ''}
                            <button onclick="openSubmissionModal(${a.id})" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-md shadow-emerald-600/20 transition-all">
                                <i class="fa-solid fa-paper-plane me-1"></i> ${mySub ? 'Update Solution' : 'Submit Answer'}
                            </button>
                        ` : `
                            <div class="flex items-center gap-2">
                                <button onclick="openAssignmentModal(${a.id})" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-indigo-300 font-semibold border border-slate-700 transition-all">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                </button>
                                <button onclick="deleteAssignment(${a.id})" class="px-3 py-1.5 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 text-xs text-rose-400 font-semibold border border-rose-900/40 transition-all">
                                    <i class="fa-solid fa-trash me-1"></i> Delete
                                </button>
                            </div>
                        `}
                    </div>
                </div>
            `;
        }).join('');
    }

    async function loadSubmissions() {
        const res = await apiFetch('/api/submissions');
        if (res.ok) {
            const subs = await res.json();
            const list = document.getElementById('submissionsList');
            const roleStr = currentUser.role.toString();
            const isStudent = roleStr === 'Student' || roleStr === '2';

            if (!subs || subs.length === 0) {
                list.innerHTML = `<div class="p-8 text-center text-slate-400 bg-slate-900/50 rounded-2xl border border-slate-800">No student submissions recorded yet.</div>`;
                return;
            }

            list.innerHTML = subs.map(s => `
                <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3 shadow-lg">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-800/80 pb-3">
                        <div>
                            <h4 class="text-sm font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-user-graduate text-indigo-400"></i> ${s.studentName}
                                <span class="text-xs font-normal text-slate-400">(${s.studentEmail})</span>
                            </h4>
                            <p class="text-xs text-indigo-400 font-semibold mt-0.5">${s.assignmentTitle}</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">
                                ${s.status} ${s.marksAwarded != null ? `(${s.marksAwarded} / ${s.maximumMarks})` : `(Max ${s.maximumMarks})`}
                            </span>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Student Solution:</span>
                        <div class="p-3 rounded-xl bg-slate-950/80 text-xs font-mono text-slate-200 border border-slate-800 whitespace-pre-wrap">${s.answerContent}</div>
                    </div>
                    ${s.attachmentUrl ? `
                        <div class="text-xs text-slate-300">
                            <i class="fa-solid fa-link text-indigo-400 me-1"></i> Attachment / Repo: 
                            <a href="${s.attachmentUrl}" target="_blank" class="text-indigo-400 hover:underline font-mono">${s.attachmentUrl}</a>
                        </div>
                    ` : ''}
                    ${s.feedback ? `
                        <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-300 space-y-1">
                            <span class="font-bold text-amber-400 block"><i class="fa-solid fa-comment-dots me-1"></i> Teacher Feedback:</span>
                            <p class="whitespace-pre-wrap">${s.feedback}</p>
                        </div>
                    ` : ''}
                    ${!isStudent ? `
                        <div class="flex justify-end pt-2">
                            <button onclick="openGradeModal(${s.id}, '${s.studentName}', '${s.answerContent.replace(/'/g, "\\'")}', ${s.maximumMarks})" class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-xs font-semibold shadow-md shadow-amber-600/20 transition-all">
                                <i class="fa-solid fa-pen-nib me-1"></i> Grade & Provide Feedback
                            </button>
                        </div>
                    ` : ''}
                </div>
            `).join('');
        }
    }

    async function loadCourses() {
        const res = await apiFetch('/api/courses');
        if (res.ok) {
            const courses = await res.json();
            const roleStr = currentUser.role.toString();
            const isAdmin = roleStr === 'Admin' || roleStr === '0';

            if (!courses || courses.length === 0) {
                document.getElementById('coursesList').innerHTML = `<div class="p-8 text-center text-slate-400 bg-slate-900/50 rounded-2xl border border-slate-800">No academic courses registered yet.</div>`;
                return;
            }

            document.getElementById('coursesList').innerHTML = courses.map(c => `
                <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-4 shadow-lg">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800/80 pb-3">
                        <div>
                            <h3 class="text-base font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-book-open text-indigo-400"></i> ${c.name} 
                                <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-mono">${c.code}</span>
                            </h3>
                            <p class="text-xs text-slate-400 mt-1">${c.description || 'No course description provided.'}</p>
                        </div>
                        ${isAdmin ? `
                            <div class="flex items-center gap-2">
                                <button onclick="openCourseModal(${c.id})" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs text-indigo-300 font-semibold border border-slate-700 transition-all">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit Course
                                </button>
                                <button onclick="deleteCourse(${c.id})" class="px-3 py-1.5 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 text-xs text-rose-400 font-semibold border border-rose-900/40 transition-all">
                                    <i class="fa-solid fa-trash me-1"></i> Delete Course
                                </button>
                            </div>
                        ` : ''}
                    </div>

                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider">Assigned Subjects & Teachers:</h4>
                            ${isAdmin ? `
                                <button onclick="openSubjectModal(null, ${c.id})" class="px-2.5 py-1 rounded-lg bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-400 text-xs font-semibold border border-indigo-500/20 transition-all">
                                    <i class="fa-solid fa-plus me-1"></i> Add Subject
                                </button>
                            ` : ''}
                        </div>
                        ${c.subjects && c.subjects.length > 0 ? `
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                ${c.subjects.map(s => `
                                    <div class="p-3 rounded-xl bg-slate-800/60 border border-slate-700/60 flex items-center justify-between text-xs gap-2">
                                        <div>
                                            <span class="font-bold text-white block">${s.name} (${s.code})</span>
                                            <span class="text-slate-400 block text-[11px]">Teacher: <strong class="text-indigo-400">${s.teacherName || 'Unassigned'}</strong></span>
                                        </div>
                                        ${isAdmin ? `
                                            <div class="flex items-center gap-1.5">
                                                <button onclick="openSubjectModal(${s.id})" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-indigo-300 font-semibold border border-slate-700 transition-all" title="Edit Subject">
                                                    <i class="fa-solid fa-pen-to-square"></i> Edit
                                                </button>
                                                <button onclick="deleteSubject(${s.id})" class="px-2.5 py-1 rounded-lg bg-rose-950/40 hover:bg-rose-900/60 text-xs text-rose-400 font-semibold border border-rose-900/40 transition-all" title="Delete Subject">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        ` : ''}
                                    </div>
                                `).join('')}
                            </div>
                        ` : `
                            <p class="text-xs text-slate-500 italic">No subjects added to this course yet.</p>
                        `}
                    </div>
                </div>
            `).join('');
        }
    }

    async function loadUsers() {
        const res = await apiFetch('/api/users');
        if (res.ok) {
            const users = await res.json();
            const roleStr = currentUser.role.toString();
            const isAdmin = roleStr === 'Admin' || roleStr === '0';

            document.getElementById('usersTableBody').innerHTML = users.map(u => `
                <tr class="hover:bg-slate-800/40 transition-colors">
                    <td class="p-4 font-bold text-white">${u.name}</td>
                    <td class="p-4 text-slate-400">${u.email}</td>
                    <td class="p-4">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${u.role === 'Admin' ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/20' : u.role === 'Teacher' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'}">
                            ${u.role}
                        </span>
                    </td>
                    <td class="p-4 text-slate-400">${u.courseName || 'N/A'}</td>
                    <td class="p-4 text-right">
                        ${isAdmin ? `
                            <button onclick="openUserModal(${u.id})" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-indigo-300 me-2 font-semibold border border-slate-700">
                                Edit
                            </button>
                            <button onclick="deleteUser(${u.id})" class="px-2.5 py-1 rounded-lg bg-rose-950/40 hover:bg-rose-900/60 text-xs text-rose-400 font-semibold border border-rose-900/40">
                                Delete
                            </button>
                        ` : '--'}
                    </td>
                </tr>
            `).join('');
        }
    }

    // --- MODAL & CRUD HANDLERS ---

    async function openUserModal(id = null) {
        const courseRes = await apiFetch('/api/courses');
        if (courseRes.ok) {
            coursesCache = await courseRes.json();
            const courseSelect = document.getElementById('userCourseInput');
            courseSelect.innerHTML = '<option value="">(None)</option>' + coursesCache.map(c => `<option value="${c.id}">${c.name} (${c.code})</option>`).join('');
        }

        if (id) {
            document.getElementById('userModalTitle').innerText = 'Edit User Account';
            const userRes = await apiFetch(`/api/users/${id}`);
            if (userRes.ok) {
                const u = await userRes.json();
                document.getElementById('userIdInput').value = u.id;
                document.getElementById('userNameInput').value = u.name;
                document.getElementById('userEmailInput').value = u.email;
                document.getElementById('userPasswordInput').value = '';
                document.getElementById('userRoleInput').value = u.role === 'Admin' || u.role === 0 ? 0 : u.role === 'Teacher' || u.role === 1 ? 1 : 2;
                document.getElementById('userCourseInput').value = u.courseId || '';
            }
        } else {
            document.getElementById('userModalTitle').innerText = 'Add User Account';
            document.getElementById('userIdInput').value = '';
            document.getElementById('userNameInput').value = '';
            document.getElementById('userEmailInput').value = '';
            document.getElementById('userPasswordInput').value = '';
            document.getElementById('userRoleInput').value = '2';
            document.getElementById('userCourseInput').value = '';
        }
        document.getElementById('userModal').classList.remove('hidden');
    }

    async function saveUser(e) {
        e.preventDefault();
        const id = document.getElementById('userIdInput').value;
        const payload = {
            name: document.getElementById('userNameInput').value,
            email: document.getElementById('userEmailInput').value,
            password: document.getElementById('userPasswordInput').value || 'Password123!',
            role: Number(document.getElementById('userRoleInput').value),
            courseId: document.getElementById('userCourseInput').value ? Number(document.getElementById('userCourseInput').value) : null
        };

        const res = await apiFetch(id ? `/api/users/${id}` : '/api/users', {
            method: id ? 'PUT' : 'POST',
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            closeModal('userModal');
            loadUsers();
            loadDashboardData();
        } else {
            let errText = 'Failed to save user';
            try { errText = (await res.json()).message || errText; } catch {}
            alert(errText);
        }
    }

    async function deleteUser(id) {
        if (!confirm('Are you sure you want to delete this user?')) return;
        const res = await apiFetch(`/api/users/${id}`, { method: 'DELETE' });
        if (res.ok) {
            loadUsers();
            loadDashboardData();
        }
    }

    async function openCourseModal(id = null) {
        if (id) {
            document.getElementById('courseModalTitle').innerText = 'Edit Academic Course';
            const res = await apiFetch(`/api/courses/${id}`);
            if (res.ok) {
                const c = await res.json();
                document.getElementById('courseIdInput').value = c.id;
                document.getElementById('courseNameInput').value = c.name;
                document.getElementById('courseCodeInput').value = c.code;
                document.getElementById('courseDescInput').value = c.description || '';
            }
        } else {
            document.getElementById('courseModalTitle').innerText = 'Add Academic Course';
            document.getElementById('courseIdInput').value = '';
            document.getElementById('courseNameInput').value = '';
            document.getElementById('courseCodeInput').value = '';
            document.getElementById('courseDescInput').value = '';
        }
        document.getElementById('courseModal').classList.remove('hidden');
    }

    async function saveCourse(e) {
        e.preventDefault();
        const id = document.getElementById('courseIdInput').value;
        const payload = {
            name: document.getElementById('courseNameInput').value,
            code: document.getElementById('courseCodeInput').value,
            description: document.getElementById('courseDescInput').value
        };
        const url = id ? `/api/courses/${id}` : '/api/courses';
        const method = id ? 'PUT' : 'POST';
        const res = await apiFetch(url, {
            method: method,
            body: JSON.stringify(payload)
        });
        if (res.ok) {
            closeModal('courseModal');
            loadCourses();
            loadDashboardData();
        } else {
            let errText = 'Failed to save course';
            try { errText = (await res.json()).message || errText; } catch {}
            alert(errText);
        }
    }

    async function deleteCourse(id) {
        if (!confirm('Are you sure you want to delete this course?')) return;
        const res = await apiFetch(`/api/courses/${id}`, { method: 'DELETE' });
        if (res.ok) {
            loadCourses();
            loadDashboardData();
        }
    }

    async function openSubjectModal(id = null, presetCourseId = null) {
        const courseRes = await apiFetch('/api/courses');
        if (courseRes.ok) {
            coursesCache = await courseRes.json();
            const courseSelect = document.getElementById('subjCourseInput');
            courseSelect.innerHTML = coursesCache.map(c => `<option value="${c.id}">${c.name} (${c.code})</option>`).join('');
        }

        const teacherRes = await apiFetch('/api/users?role=1');
        if (teacherRes.ok) {
            teachersCache = await teacherRes.json();
            const teacherSelect = document.getElementById('subjTeacherInput');
            teacherSelect.innerHTML = '<option value="">(Unassigned)</option>' + teachersCache.map(t => `<option value="${t.id}">${t.name} (${t.email})</option>`).join('');
        }

        if (id) {
            document.getElementById('subjectModalTitle').innerText = 'Edit Subject & Assign Teacher';
            const subjRes = await apiFetch('/api/courses/subjects');
            if (subjRes.ok) {
                const subjects = await subjRes.json();
                const s = subjects.find(x => x.id === id);
                if (s) {
                    document.getElementById('subjIdInput').value = s.id;
                    document.getElementById('subjNameInput').value = s.name;
                    document.getElementById('subjCodeInput').value = s.code;
                    document.getElementById('subjCourseInput').value = s.courseId;
                    document.getElementById('subjTeacherInput').value = s.teacherId || '';
                }
            }
        } else {
            document.getElementById('subjectModalTitle').innerText = 'Add Subject & Assign Teacher';
            document.getElementById('subjIdInput').value = '';
            document.getElementById('subjNameInput').value = '';
            document.getElementById('subjCodeInput').value = '';
            if (presetCourseId) {
                document.getElementById('subjCourseInput').value = presetCourseId;
            }
            document.getElementById('subjTeacherInput').value = '';
        }

        document.getElementById('subjectModal').classList.remove('hidden');
    }

    async function saveSubject(e) {
        e.preventDefault();
        const id = document.getElementById('subjIdInput').value;
        const payload = {
            name: document.getElementById('subjNameInput').value,
            code: document.getElementById('subjCodeInput').value,
            courseId: Number(document.getElementById('subjCourseInput').value),
            teacherId: document.getElementById('subjTeacherInput').value ? Number(document.getElementById('subjTeacherInput').value) : null
        };
        const url = id ? `/api/courses/subjects/${id}` : '/api/courses/subjects';
        const method = id ? 'PUT' : 'POST';
        const res = await apiFetch(url, {
            method: method,
            body: JSON.stringify(payload)
        });
        if (res.ok) {
            closeModal('subjectModal');
            loadCourses();
        } else {
            let errText = 'Failed to save subject';
            try { errText = (await res.json()).message || errText; } catch {}
            alert(errText);
        }
    }

    async function deleteSubject(id) {
        if (!confirm('Are you sure you want to delete this subject?')) return;
        const res = await apiFetch(`/api/courses/subjects/${id}`, { method: 'DELETE' });
        if (res.ok) {
            loadCourses();
        }
    }

    function openAssignmentModal(id = null) {
        const select = document.getElementById('asgnSubjectId');
        select.innerHTML = subjectsCache.map(s => `<option value="${s.id}">${s.name} (${s.code})</option>`).join('');

        if (id) {
            const a = assignmentsCache.find(x => x.id === id);
            document.getElementById('asgnId').value = a.id;
            document.getElementById('asgnTitle').value = a.title;
            document.getElementById('asgnDesc').value = a.description;
            document.getElementById('asgnMaxMarks').value = a.maximumMarks;
        } else {
            document.getElementById('asgnId').value = '';
            document.getElementById('asgnTitle').value = '';
            document.getElementById('asgnDesc').value = '';
        }
        document.getElementById('assignmentModal').classList.remove('hidden');
    }

    async function saveAssignment(e) {
        e.preventDefault();
        const id = document.getElementById('asgnId').value;
        const payload = {
            title: document.getElementById('asgnTitle').value,
            description: document.getElementById('asgnDesc').value,
            subjectId: Number(document.getElementById('asgnSubjectId').value),
            deadline: new Date(document.getElementById('asgnDeadline').value || Date.now() + 7*86400000).toISOString(),
            maximumMarks: Number(document.getElementById('asgnMaxMarks').value),
            isDraft: document.getElementById('asgnIsDraft').checked
        };

        const res = await apiFetch(id ? `/api/assignments/${id}` : '/api/assignments', {
            method: id ? 'PUT' : 'POST',
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            closeModal('assignmentModal');
            loadDashboardData();
            switchTab('assignments');
        }
    }

    async function deleteAssignment(id) {
        if (!confirm('Are you sure you want to delete this assignment?')) return;
        const res = await apiFetch(`/api/assignments/${id}`, { method: 'DELETE' });
        if (res.ok) {
            loadDashboardData();
            loadAssignments();
        }
    }

    function openSubmissionModal(assignmentId) {
        document.getElementById('subAsgnId').value = assignmentId;
        document.getElementById('submissionModal').classList.remove('hidden');
    }

    async function saveSubmission(e) {
        e.preventDefault();
        const payload = {
            assignmentId: Number(document.getElementById('subAsgnId').value),
            answerContent: document.getElementById('subAnswerContent').value,
            attachmentUrl: document.getElementById('subAttachmentUrl').value || null
        };
        const res = await apiFetch('/api/submissions', {
            method: 'POST',
            body: JSON.stringify(payload)
        });
        if (res.ok) {
            closeModal('submissionModal');
            loadDashboardData();
            switchTab('assignments');
        }
    }

    function openGradeModal(id, studentName, answer, maxMarks) {
        document.getElementById('gradeSubId').value = id;
        document.getElementById('gradeStudentInfo').innerText = studentName;
        document.getElementById('gradeAnswerPreview').innerText = answer;
        document.getElementById('gradeMarks').value = maxMarks;
        document.getElementById('gradeModal').classList.remove('hidden');
    }

    async function saveGrade(e) {
        e.preventDefault();
        const id = document.getElementById('gradeSubId').value;
        const payload = {
            marksAwarded: Number(document.getElementById('gradeMarks').value),
            feedback: document.getElementById('gradeFeedback').value,
            status: Number(document.getElementById('gradeStatus').value)
        };
        const res = await apiFetch(`/api/submissions/${id}/grade`, {
            method: 'PUT',
            body: JSON.stringify(payload)
        });
        if (res.ok) {
            closeModal('gradeModal');
            loadSubmissions();
        }
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    // Auto-init on page load
    window.addEventListener('DOMContentLoaded', () => {
        renderPortal();
    });
</script>
}
